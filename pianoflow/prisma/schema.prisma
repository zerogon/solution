generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  DORMANT
  WITHDRAWN
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum CreditChangeReason {
  RESERVE
  CANCEL
  ADMIN_ADD
  ADMIN_SUB
  ADMIN_ADJUST
}

enum Specialty {
  CLASSICAL
  JAZZ
  ACCOMPANIMENT
}

model User {
  id                 String     @id @default(uuid())
  name               String
  phone              String     @unique
  loginId            String     @unique @map("login_id")
  password           String
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  role               Role       @default(STUDENT)
  status             UserStatus @default(ACTIVE)
  remainingLessons   Int        @default(0) @map("remaining_lessons")
  specialties        Specialty[] @default([])
  enrollmentStart    DateTime?  @map("enrollment_start")
  enrollmentEnd      DateTime?  @map("enrollment_end")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  availability      TeacherAvailability[]
  scheduleExceptions TeacherScheduleException[]
  studentBookings Reservation[]         @relation("StudentReservations")
  teacherBookings Reservation[]         @relation("TeacherReservations")
  creditLogs      LessonCreditLog[]     @relation("StudentCreditLogs")
  actorCreditLogs LessonCreditLog[]     @relation("ActorCreditLogs")

  authoredAnnouncements Announcement[]     @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[] @relation("UserAnnouncementReads")

  @@map("users")
}

model TeacherAvailability {
  id        String  @id @default(uuid())
  teacherId String  @map("teacher_id")
  weekday   Weekday
  hours     Int[]   @default([])

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, weekday])
  @@map("teacher_availability")
}

// 특정 날짜에 대한 요일 기본 스케줄의 일회성 예외.
// hours = 그날 예약 가능 시각. 빈 배열 = 휴무. 있으면 요일 기본값을 완전히 덮어쓴다.
model TeacherScheduleException {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  date      DateTime @map("date") // 해당 KST 일자 자정의 UTC (parseKstDate 규약과 동일)
  hours     Int[]    @default([])
  createdAt DateTime @default(now()) @map("created_at")

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@map("teacher_schedule_exception")
}

model Reservation {
  id            String            @id @default(uuid())
  teacherId     String            @map("teacher_id")
  studentId     String            @map("student_id")
  slotDatetime  DateTime          @map("slot_datetime")
  status        ReservationStatus @default(ACTIVE)
  isPrivate     Boolean           @default(false) @map("is_private")
  forcedByAdmin Boolean           @default(false) @map("forced_by_admin")
  feedback       String?          // 선생님이 남긴 수업 피드백
  feedbackAt     DateTime?        @map("feedback_at")
  feedbackReadAt DateTime?        @map("feedback_read_at") // 학생이 피드백을 확인한 시각
  cancelledAt   DateTime?         @map("cancelled_at")
  cancelledBy   String?           @map("cancelled_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  teacher User @relation("TeacherReservations", fields: [teacherId], references: [id])
  student User @relation("StudentReservations", fields: [studentId], references: [id])

  @@index([teacherId, slotDatetime])
  @@index([studentId, slotDatetime])
  @@map("reservations")
}

model LessonCreditLog {
  id            String             @id @default(uuid())
  studentId     String             @map("student_id")
  delta         Int
  reason        CreditChangeReason
  actorId       String?            @map("actor_id")
  reservationId String?            @map("reservation_id")
  memo          String?
  createdAt     DateTime           @default(now()) @map("created_at")

  student User  @relation("StudentCreditLogs", fields: [studentId], references: [id])
  actor   User? @relation("ActorCreditLogs", fields: [actorId], references: [id])

  @@index([studentId, createdAt])
  @@map("lesson_credit_log")
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  isPublished Boolean   @default(true) @map("is_published") // 게시(공개)/숨김(임시저장)
  isPinned    Boolean   @default(false) @map("is_pinned") // 중요(상단 고정)
  authorId    String?   @map("author_id")
  publishedAt DateTime? @map("published_at") // 최초 게시 시각 — 정렬·'새 공지' 기준
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User?              @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  reads  AnnouncementRead[]

  @@index([isPublished, isPinned, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id") // 읽은 사람(학생 또는 선생님)
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("UserAnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}
