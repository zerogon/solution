// Sulki Holiday — 한 사람의 연차 장부.
// datasource url은 prisma.config.ts가 공급한다(.env.local > .env, scripts/load-env.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeaveType {
  FULL_DAY
  AM_HALF
  PM_HALF
}

/// 앱 주인 1명. 행은 항상 하나뿐이다(id = "owner").
model Owner {
  id             String   @id @default("owner")
  name           String
  password       String
  /// 쉬는 요일. 0=일 … 6=토 (JS getUTCDay 규약). 연차 일수 계산에서 제외된다.
  closedWeekdays Int[]    @default([0, 6]) @map("closed_weekdays")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("owner")
}

/// 연도별 부여(1/1~12/31). 엑셀의 "올해 연차 n일" 칸.
model LeaveYear {
  id              String   @id @default(uuid())
  year            Int      @unique
  grantedDays     Float    @map("granted_days")
  carriedOverDays Float    @default(0) @map("carried_over_days")
  memo            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("leave_years")
}

/// 연차 기록 1줄. 사용 일수는 저장된 행의 합으로 계산한다(누계 컬럼 없음).
model LeaveEntry {
  id         String    @id @default(uuid())
  type       LeaveType
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  /// 차감 일수. 0.5 단위. 보통 자동 계산(쉬는 요일·공휴일 제외)이고 manualDays면 직접 입력값.
  days       Float
  manualDays Boolean   @default(false) @map("manual_days")
  memo       String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  dayRows LeaveEntryDay[]

  @@index([startDate])
  @@map("leave_entries")
}

/// 기록이 덮는 날짜 1개 = 행 1개. `date` 유니크가 같은 날 중복 기록을 DB 층에서 막고,
/// 캘린더가 이 표를 읽는다. 기록을 수정하면 같은 트랜잭션에서 다시 만든다.
model LeaveEntryDay {
  id      String    @id @default(uuid())
  entryId String    @map("entry_id")
  date    DateTime  @unique @db.Date
  type    LeaveType

  entry LeaveEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("leave_entry_days")
}
