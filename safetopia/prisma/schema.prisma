// Sulki Holiday — 한 사람의 연차 장부.
// datasource url은 prisma.config.ts가 공급한다(.env.local > .env, scripts/load-env.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeaveType {
  FULL_DAY
  AM_HALF
  PM_HALF
}

/// 앱 주인 1명. 행은 항상 하나뿐이다(id = "owner").
model Owner {
  id             String   @id @default("owner")
  name           String
  password       String
  /// 쉬는 요일. 0=일 … 6=토 (JS getUTCDay 규약). 연차 일수 계산에서 제외된다.
  closedWeekdays Int[]    @default([0, 6]) @map("closed_weekdays")
  /// 입사일. 연차 회차·발생 일수는 전부 이 날짜에서 계산한다(`leave-accrual.ts`). null = 아직 미설정.
  hireDate       DateTime? @map("hire_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("owner")
}

/// 회차별 조정. 발생 일수는 저장하지 않고 입사일로 계산한다 — 회사 사정으로 다른 만큼(이월·보정)만 적는다.
/// 회차 경계도 저장하지 않는다(입사일 + index로 매번 계산). 행은 조정이 있는 회차에만 있다.
model LeavePeriod {
  id              String   @id @default(uuid())
  /// 1-based 회차. 1 = 입사 첫해(1년 미만).
  index           Int      @unique
  carriedOverDays Float    @default(0) @map("carried_over_days")
  /// 보정(음수 가능). 예: 출근율 미달 −15, 회사 특별 부여 +2.
  adjustedDays    Float    @default(0) @map("adjusted_days")
  memo            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("leave_periods")
}

/// 연차 기록 1줄. 사용 일수는 저장된 행의 합으로 계산한다(누계 컬럼 없음).
model LeaveEntry {
  id         String    @id @default(uuid())
  type       LeaveType
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  /// 차감 일수. 0.5 단위. 보통 자동 계산(쉬는 요일·공휴일 제외)이고 manualDays면 직접 입력값.
  days       Float
  manualDays Boolean   @default(false) @map("manual_days")
  memo       String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  dayRows LeaveEntryDay[]

  @@index([startDate])
  @@map("leave_entries")
}

/// 기록이 덮는 날짜 1개 = 행 1개. `date` 유니크가 같은 날 중복 기록을 DB 층에서 막고,
/// 캘린더가 이 표를 읽는다. 기록을 수정하면 같은 트랜잭션에서 다시 만든다.
model LeaveEntryDay {
  id      String    @id @default(uuid())
  entryId String    @map("entry_id")
  date    DateTime  @unique @db.Date
  type    LeaveType

  entry LeaveEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("leave_entry_days")
}
