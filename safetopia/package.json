{
  "name": "safetopia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:local:up": "docker compose up -d",
    "db:local:down": "docker compose down",
    "db:local:dev": "tsx scripts/assert-local-db.ts && prisma migrate dev",
    "db:local:migrate": "tsx scripts/assert-local-db.ts && prisma migrate deploy",
    "db:local:seed": "tsx scripts/assert-local-db.ts && prisma db seed",
    "db:local:reset": "tsx scripts/assert-local-db.ts && prisma migrate reset --force",
    "db:studio": "prisma studio",
    "race-test": "tsx scripts/assert-local-db.ts && tsx scripts/race-test.ts",
    "icons:generate": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "shadcn": "^4.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
