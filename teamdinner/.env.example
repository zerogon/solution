# --- Database (Neon PostgreSQL) ---
# 앱(@neondatabase/serverless WebSocket Pool)과 drizzle-kit(pg) 둘 다 이 값 하나만 읽는다.
# Vercel의 Neon 통합을 쓰면 DATABASE_URL이 자동으로 들어온다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# --- 로컬 개발 (선택) ---
# `docker compose up -d` 로 Postgres + Neon wsproxy를 띄운 뒤 아래 둘을 .env.local에 둔다.
# DATABASE_URL="postgres://postgres:postgres@db.localtest.me:5432/teamdinner"
# NEON_LOCAL_PROXY="db.localtest.me:4444"
