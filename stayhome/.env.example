# --- Database (Neon PostgreSQL) ---
# Pooled connection — used by the running app via @prisma/adapter-pg
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"
# Direct connection — used by `prisma migrate` / `prisma db push`
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"

# --- NextAuth v5 ---
# `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"
# 로그인은 Credentials(ID/PW · bcrypt) 하나뿐이다 — OAuth 프로바이더 없음.
# 계정은 `users` 테이블에 있고 `npm run db:seed`가 admin 1명을 만든다.

# --- Resort credential encryption (AES-256-GCM) ---
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RESORT_CRED_SECRET=""

# --- Inngest ---
# Required only in production / Inngest cloud. Local dev uses inngest-cli.
# The Vercel-Inngest integration writes both of these into the project itself —
# set them by hand only if you are not using the integration.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Playwright on Vercel ---
# Sparticuz tarball, x64 (Vercel functions are x64). The version must match BOTH
# the installed @sparticuz/chromium-min AND the Chromium that playwright-core
# expects — node_modules/playwright-core/browsers.json → browserVersion.
# A mismatch still launches and fails much later, in CDP calls. Current pairing:
#   playwright-core 1.60 → Chromium 148 → chromium-min 148.0.0
CHROMIUM_PACK_URL="https://github.com/Sparticuz/chromium/releases/download/v148.0.0/chromium-v148.0.0-pack.x64.tar"

# --- Local debugging ---
# Set to "false" to watch the crawler in a real browser window during dev.
# Ignored in production (CHROMIUM_PACK_URL is set → forced headless).
CRAWLER_HEADLESS="true"

# --- Cron protection ---
# Random secret; required header `Authorization: Bearer ${CRON_SECRET}` on /api/cron/refresh
CRON_SECRET=""

# --- Slack webhook for crawl failure alerts ---
# Empty = notifySlack does nothing, so a failed scheduled crawl is silent.
# The cron runs 8×/day unattended; treat this as required in production.
SLACK_WEBHOOK_URL=""
